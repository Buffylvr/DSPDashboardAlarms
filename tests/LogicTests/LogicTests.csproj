<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline checks of the alarm state machine (no game needed). Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DashboardAlarms.LogicTests</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <Import Project="..\..\Directory.Build.user.props" Condition="Exists('..\..\Directory.Build.user.props')" />

  <PropertyGroup>
    <DSPDir Condition="'$(DSPDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Dyson Sphere Program</DSPDir>
    <ManagedDir>$(DSPDir)\DSPGAME_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\..\DashboardAlarms.csproj" />
    <!-- Copied next to the test exe so the alarm types load; nothing game-side is executed. -->
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath></Reference>
    <Reference Include="DSPModSave"><HintPath>$(BepInExDir)\plugins\CommonAPI-DSPModSave\DSPModSave.dll</HintPath></Reference>
  </ItemGroup>

</Project>
